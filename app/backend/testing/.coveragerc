[run]
data_file = app/backend/testing/.coverage
branch= true
relative_files = true
source = 
    app/backend/src
    app/backend/ml

[paths]
source =
    app/backend
    /github/workspace/app/backend

[report]
show_missing = true
omit = 
    app/backend/testing/*
    app/backend/seed.py
    app/backend/test_api.py